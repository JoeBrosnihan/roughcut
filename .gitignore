# Build output. Also holds target/dev-config, the settings and autosave slot
# used by anything launched through cargo.
/target

# libmpv, fetched per the instructions in docs/building.md. ~114 MB.
/vendor

# Scratch media and the Shotcut-authored .mlt files the export schema was
# derived from. Regenerate as needed; not part of the build.
/reference

# Generated by the frame-accuracy test with ROUGHCUT_KEEP_OUTPUT=1.
# See docs/verification.md.
/acceptance

# Projects and their proxy caches.
*.roughcut
.roughcut-proxies/
